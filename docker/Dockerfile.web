# Use Node.js 18 LTS as base image
FROM node:20.10-alpine

# Install git and wget (needed for cloning and health checks)
RUN apk add --no-cache git wget

# Set working directory
WORKDIR /app

COPY web .

RUN npm install --global corepack@latest && \
    corepack enable pnpm && \
    corepack use pnpm@latest-10

# Install dependencies
RUN pnpm install

# Create a non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S webuser -u 1001

# Change ownership of the app directory
RUN chown -R webuser:nodejs /app
USER webuser

# Expose the port that the app will run on
EXPOSE 4200

# Set environment variables for the backend URL
ENV BACKEND_URL=http://localhost:6999

# Start the development server
CMD ["sh", "-c", "pnpm run serve --backend=$BACKEND_URL"]
