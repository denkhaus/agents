# Use Node.js 18 LTS as base image
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install git and wget (needed for cloning and health checks)
RUN apk add --no-cache git wget

# Clone the ADK web repository
RUN git clone https://github.com/google/adk-web.git .

# Install dependencies
RUN npm install

# Expose the port that the app will run on
EXPOSE 4200

# Set environment variables for the backend URL
ENV BACKEND_URL=http://localhost:6999

# Create a startup script that configures the backend URL and starts the server
COPY <<EOF /app/start.sh
#!/bin/sh
set -e

echo "Starting ADK Web Frontend..."
echo "Backend URL: \${BACKEND_URL}"

# Start the development server with proper configuration
exec npm run serve --backend=\${BACKEND_URL} -- --port=4200 --host=0.0.0.0
EOF

RUN chmod +x /app/start.sh

# Create a non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Change ownership of the app directory
RUN chown -R nextjs:nodejs /app
USER nextjs

# Start the development server
CMD ["/app/start.sh"]